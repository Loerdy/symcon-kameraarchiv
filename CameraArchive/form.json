{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "Label",
            "caption": "UniFi Protect",
            "bold": true
        },
        {
            "type": "ValidationTextBox",
            "name": "Host",
            "caption": "Protect console (host or IP)"
        },
        {
            "type": "PasswordTextBox",
            "name": "APIKey",
            "caption": "API key"
        },
        {
            "type": "Label",
            "caption": "Create the API key in UniFi OS under Control Plane > Integrations. It has administrator rights: keep it secret.",
            "italic": true
        },
        {
            "type": "CheckBox",
            "name": "SkipCertificateCheck",
            "caption": "Do not verify certificate (for self-signed certificates)"
        },
        {
            "type": "Label",
            "caption": "Cameras: click \"Fetch cameras\" below, select the cameras and click \"Apply\".",
            "bold": true
        },
        {
            "type": "List",
            "name": "Cameras",
            "caption": "Cameras",
            "rowCount": 10,
            "add": false,
            "delete": true,
            "loadValuesFromConfiguration": false,
            "sort": {
                "column": "Name",
                "direction": "ascending"
            },
            "columns": [
                {
                    "caption": "Active",
                    "name": "Enabled",
                    "width": "70px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Images",
                    "name": "Images",
                    "width": "90px",
                    "add": 30,
                    "edit": {
                        "type": "NumberSpinner",
                        "minimum": 1,
                        "maximum": 200
                    }
                },
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "auto",
                    "add": "",
                    "save": true
                },
                {
                    "caption": "Type",
                    "name": "Type",
                    "width": "180px",
                    "add": "",
                    "save": true
                },
                {
                    "caption": "State",
                    "name": "State",
                    "width": "120px",
                    "add": "",
                    "save": true
                },
                {
                    "caption": "Full HD",
                    "name": "FullHDText",
                    "width": "80px",
                    "add": ""
                },
                {
                    "caption": "Snapshot",
                    "name": "Snapshot",
                    "width": "200px",
                    "add": ""
                },
                {
                    "caption": "Stored",
                    "name": "Stored",
                    "width": "130px",
                    "add": ""
                },
                {
                    "caption": "Camera ID",
                    "name": "CameraID",
                    "width": "220px",
                    "add": "",
                    "save": true
                },
                {
                    "caption": "Full HD supported",
                    "name": "FullHD",
                    "width": "0px",
                    "add": false,
                    "visible": false,
                    "save": true
                }
            ],
            "values": []
        },
        {
            "type": "Label",
            "caption": "Triggers: a snapshot is taken when the condition of a trigger is met.",
            "bold": true
        },
        {
            "type": "List",
            "name": "Triggers",
            "caption": "Triggers",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "loadValuesFromConfiguration": false,
            "form": "return json_decode(CAR_UITriggerForm($id, $Triggers['VariableID'] ?? 0, $Triggers['Condition'] ?? 0), true);",
            "columns": [
                {
                    "caption": "Active",
                    "name": "Active",
                    "width": "70px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "160px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Variable",
                    "name": "VariableID",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Condition",
                    "name": "Condition",
                    "width": "190px",
                    "add": 0,
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Any change",
                                "value": 0
                            },
                            {
                                "caption": "Any update",
                                "value": 1
                            },
                            {
                                "caption": "Changes to value",
                                "value": 2
                            },
                            {
                                "caption": "Is updated with value",
                                "value": 3
                            }
                        ]
                    }
                },
                {
                    "caption": "Cameras",
                    "name": "CameraNames",
                    "width": "200px",
                    "add": ""
                },
                {
                    "caption": "Delay",
                    "name": "Delay",
                    "width": "80px",
                    "add": 0,
                    "edit": {
                        "type": "NumberSpinner",
                        "suffix": "s",
                        "minimum": 0,
                        "maximum": 60
                    }
                },
                {
                    "caption": "Lockout",
                    "name": "Lockout",
                    "width": "90px",
                    "add": 30,
                    "edit": {
                        "type": "NumberSpinner",
                        "suffix": "s",
                        "minimum": 0,
                        "maximum": 3600
                    }
                },
                {
                    "caption": "Value",
                    "name": "Value",
                    "width": "0px",
                    "add": "",
                    "visible": false,
                    "save": true
                }
            ],
            "values": []
        },
        {
            "type": "NumberSpinner",
            "name": "CameraLockout",
            "caption": "Minimum interval between two snapshots of a camera",
            "suffix": "s",
            "minimum": 0,
            "maximum": 3600
        },
        {
            "type": "Label",
            "caption": "Storage",
            "bold": true
        },
        {
            "type": "CheckBox",
            "name": "MemoryCache",
            "caption": "Use in-memory cache"
        },
        {
            "type": "Label",
            "caption": "Do not disable this option on the SymBox or on SD/SSD storage. With the cache, images are kept in RAM and only written at shutdown (lost on a power failure). Without it, every image is written to the storage immediately."
        },
        {
            "type": "Label",
            "name": "StorageInfo",
            "caption": "Stored images: 0"
        },
        {
            "type": "CheckBox",
            "name": "ResizeEnabled",
            "caption": "Downscale images before storing"
        },
        {
            "type": "NumberSpinner",
            "name": "ResizeWidth",
            "caption": "Maximum width",
            "suffix": "px",
            "minimum": 320,
            "maximum": 3840
        },
        {
            "type": "NumberSpinner",
            "name": "ResizeQuality",
            "caption": "JPEG quality",
            "suffix": "%",
            "minimum": 30,
            "maximum": 95
        },
        {
            "type": "Label",
            "name": "GDMissing",
            "caption": "PHP extension GD is not available: images are stored without resizing.",
            "visible": false
        }
    ],
    "actions": [
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "caption": "Test connection",
                    "onClick": "CAR_UITestConnection($id);"
                },
                {
                    "type": "Button",
                    "caption": "Fetch cameras",
                    "onClick": "CAR_UIFetchCameras($id);"
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Select",
                    "name": "SnapshotCamera",
                    "caption": "Camera",
                    "options": [
                        {
                            "caption": "No active camera",
                            "value": ""
                        }
                    ]
                },
                {
                    "type": "Button",
                    "caption": "Test snapshot",
                    "onClick": "CAR_UITestSnapshot($id, $SnapshotCamera);"
                }
            ]
        },
        {
            "type": "Button",
            "caption": "Delete images of removed cameras",
            "confirm": "Delete all stored images of cameras that are no longer in the camera list?",
            "onClick": "CAR_UIDeleteRemovedCameraImages($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Ready"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Protect console host or API key is missing"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "PHP extension cURL is not available"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "Protect console not reachable"
        },
        {
            "code": 204,
            "icon": "error",
            "caption": "API key invalid or without permission"
        },
        {
            "code": 205,
            "icon": "error",
            "caption": "Certificate could not be verified (see option \"Do not verify certificate\")"
        },
        {
            "code": 206,
            "icon": "error",
            "caption": "Unexpected response from the Protect console"
        }
    ]
}
