{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "Label",
            "caption": "The name of this instance is shown on the camera button of the tile. Connection and image settings are made in the Camera Archive Console.",
            "italic": true
        },
        {
            "type": "ValidationTextBox",
            "name": "CameraID",
            "caption": "Protect camera ID (set by the configurator)"
        },
        {
            "type": "NumberSpinner",
            "name": "Images",
            "caption": "Images in RAM",
            "minimum": 1,
            "maximum": 200
        },
        {
            "type": "Label",
            "name": "StorageInfo",
            "caption": "Stored images: 0"
        },
        {
            "type": "Label",
            "caption": "Triggers: a snapshot is taken when the condition of a trigger is met.",
            "bold": true
        },
        {
            "type": "List",
            "name": "Triggers",
            "caption": "Triggers",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "loadValuesFromConfiguration": false,
            "form": "return json_decode(CAR_UITriggerForm($id, $Triggers['VariableID'] ?? 0, $Triggers['Condition'] ?? 0), true);",
            "columns": [
                {
                    "caption": "Active",
                    "name": "Active",
                    "width": "70px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "160px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Variable",
                    "name": "VariableID",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Condition",
                    "name": "Condition",
                    "width": "190px",
                    "add": 0,
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Any change",
                                "value": 0
                            },
                            {
                                "caption": "Any update",
                                "value": 1
                            },
                            {
                                "caption": "Changes to value",
                                "value": 2
                            },
                            {
                                "caption": "Is updated with value",
                                "value": 3
                            }
                        ]
                    }
                },
                {
                    "caption": "Delay",
                    "name": "Delay",
                    "width": "80px",
                    "add": 0,
                    "edit": {
                        "type": "NumberSpinner",
                        "suffix": "s",
                        "minimum": 0,
                        "maximum": 60
                    }
                },
                {
                    "caption": "Lockout",
                    "name": "Lockout",
                    "width": "90px",
                    "add": 30,
                    "edit": {
                        "type": "NumberSpinner",
                        "suffix": "s",
                        "minimum": 0,
                        "maximum": 3600
                    }
                },
                {
                    "caption": "Value",
                    "name": "Value",
                    "width": "0px",
                    "add": "",
                    "visible": false,
                    "save": true
                },
                {
                    "caption": "Value",
                    "name": "ValueBool",
                    "width": "0px",
                    "add": "true",
                    "visible": false,
                    "save": true
                }
            ],
            "values": []
        },
        {
            "type": "NumberSpinner",
            "name": "CameraLockout",
            "caption": "Minimum interval between two snapshots",
            "suffix": "s",
            "minimum": 0,
            "maximum": 3600
        },
        {
            "type": "Label",
            "caption": "Live view in the tile (image sequence, not stored)",
            "bold": true
        },
        {
            "type": "CheckBox",
            "name": "LiveAutoStart",
            "caption": "Start the live view when the tile is shown"
        },
        {
            "type": "NumberSpinner",
            "name": "LiveDuration",
            "caption": "Maximum duration of the live view",
            "suffix": "min",
            "minimum": 1,
            "maximum": 30
        },
        {
            "type": "NumberSpinner",
            "name": "LiveInterval",
            "caption": "Interval of the live view",
            "suffix": "s",
            "digits": 1,
            "minimum": 0.5,
            "maximum": 30
        },
        {
            "type": "Label",
            "caption": "Every open and visible tile with live view asks the Protect console once per interval. The live view stops when the tile is no longer visible and starts again automatically when it is shown again.",
            "italic": true
        },
        {
            "type": "Label",
            "caption": "NAS: the console uploads the original of every snapshot (address and access are set in the console).",
            "bold": true
        },
        {
            "type": "CheckBox",
            "name": "NASUpload",
            "caption": "Upload snapshots to the NAS"
        },
        {
            "type": "ValidationTextBox",
            "name": "NASFolder",
            "caption": "Folder on the NAS (empty: name of this instance)"
        },
        {
            "type": "NumberSpinner",
            "name": "NASRetention",
            "caption": "Keep images on the NAS for",
            "suffix": "days",
            "minimum": 0,
            "maximum": 3650
        },
        {
            "type": "Label",
            "caption": "0 days: the module never deletes images on the NAS. Images marked as \"keep\" in the tile are copied into the subfolder for kept images, which is never deleted.",
            "italic": true
        },
        {
            "type": "Label",
            "caption": "Notifications: sent after a snapshot of a trigger has been stored.",
            "bold": true
        },
        {
            "type": "List",
            "name": "Notifications",
            "caption": "Notifications",
            "rowCount": 4,
            "add": true,
            "delete": true,
            "loadValuesFromConfiguration": false,
            "form": "return json_decode(CAR_UINotificationForm($id, $Notifications['Type'] ?? 0, $Notifications['ConditionVariableID'] ?? 0), true);",
            "columns": [
                {
                    "caption": "Active",
                    "name": "Active",
                    "width": "70px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Kind",
                    "name": "Type",
                    "width": "180px",
                    "add": 0,
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "E-mail",
                                "value": 0
                            },
                            {
                                "caption": "Push notification",
                                "value": 1
                            }
                        ]
                    }
                },
                {
                    "caption": "Trigger (empty: all)",
                    "name": "Trigger",
                    "width": "200px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Condition",
                    "name": "ConditionVariableID",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "SMTP instance",
                    "name": "SMTPID",
                    "width": "0px",
                    "add": 0,
                    "visible": false,
                    "save": true
                },
                {
                    "caption": "Recipient",
                    "name": "Recipient",
                    "width": "0px",
                    "add": "",
                    "visible": false,
                    "save": true
                },
                {
                    "caption": "Tile visualization",
                    "name": "VisuID",
                    "width": "0px",
                    "add": 0,
                    "visible": false,
                    "save": true
                },
                {
                    "caption": "Opens on tap",
                    "name": "PushTargetID",
                    "width": "0px",
                    "add": 0,
                    "visible": false,
                    "save": true
                },
                {
                    "caption": "Value",
                    "name": "ConditionValue",
                    "width": "0px",
                    "add": "",
                    "visible": false,
                    "save": true
                },
                {
                    "caption": "Value",
                    "name": "ConditionValueBool",
                    "width": "0px",
                    "add": "",
                    "visible": false,
                    "save": true
                }
            ],
            "values": []
        }
    ],
    "actions": [
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "caption": "Test snapshot",
                    "onClick": "CAR_UITestSnapshot($id);"
                },
                {
                    "type": "Button",
                    "caption": "Delete all images",
                    "confirm": "Delete all stored images of this camera, including images marked as \"keep\"?",
                    "onClick": "CAR_UIDeleteImages($id);"
                }
            ]
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Ready"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "No camera selected (create the instance with the configurator)"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Not connected to a Camera Archive Console"
        }
    ]
}
