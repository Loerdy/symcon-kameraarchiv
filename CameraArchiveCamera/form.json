{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "Label",
            "caption": "The name of this instance is shown on the camera button of the tile. Connection and image settings are made in the Camera Archive Console.",
            "italic": true
        },
        {
            "type": "ValidationTextBox",
            "name": "CameraID",
            "caption": "Protect camera ID (set by the configurator)"
        },
        {
            "type": "NumberSpinner",
            "name": "Images",
            "caption": "Images in RAM",
            "minimum": 1,
            "maximum": 200
        },
        {
            "type": "Label",
            "name": "StorageInfo",
            "caption": "Stored images: 0"
        },
        {
            "type": "Label",
            "caption": "Triggers: a snapshot is taken when the condition of a trigger is met.",
            "bold": true
        },
        {
            "type": "List",
            "name": "Triggers",
            "caption": "Triggers",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "loadValuesFromConfiguration": false,
            "form": "return json_decode(CAR_UITriggerForm($id, $Triggers['VariableID'] ?? 0, $Triggers['Condition'] ?? 0), true);",
            "columns": [
                {
                    "caption": "Active",
                    "name": "Active",
                    "width": "70px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "160px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Variable",
                    "name": "VariableID",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Condition",
                    "name": "Condition",
                    "width": "190px",
                    "add": 0,
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Any change",
                                "value": 0
                            },
                            {
                                "caption": "Any update",
                                "value": 1
                            },
                            {
                                "caption": "Changes to value",
                                "value": 2
                            },
                            {
                                "caption": "Is updated with value",
                                "value": 3
                            }
                        ]
                    }
                },
                {
                    "caption": "Delay",
                    "name": "Delay",
                    "width": "80px",
                    "add": 0,
                    "edit": {
                        "type": "NumberSpinner",
                        "suffix": "s",
                        "minimum": 0,
                        "maximum": 60
                    }
                },
                {
                    "caption": "Lockout",
                    "name": "Lockout",
                    "width": "90px",
                    "add": 30,
                    "edit": {
                        "type": "NumberSpinner",
                        "suffix": "s",
                        "minimum": 0,
                        "maximum": 3600
                    }
                },
                {
                    "caption": "Value",
                    "name": "Value",
                    "width": "0px",
                    "add": "",
                    "visible": false,
                    "save": true
                },
                {
                    "caption": "Value",
                    "name": "ValueBool",
                    "width": "0px",
                    "add": "true",
                    "visible": false,
                    "save": true
                }
            ],
            "values": []
        },
        {
            "type": "NumberSpinner",
            "name": "CameraLockout",
            "caption": "Minimum interval between two snapshots",
            "suffix": "s",
            "minimum": 0,
            "maximum": 3600
        }
    ],
    "actions": [
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "caption": "Test snapshot",
                    "onClick": "CAR_UITestSnapshot($id);"
                },
                {
                    "type": "Button",
                    "caption": "Delete all images",
                    "confirm": "Delete all stored images of this camera, including images marked as \"keep\"?",
                    "onClick": "CAR_UIDeleteImages($id);"
                }
            ]
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Ready"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "No camera selected (create the instance with the configurator)"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Not connected to a Camera Archive Console"
        }
    ]
}
